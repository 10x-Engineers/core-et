set groupId0 [waveform add -groups {{Prefetch Check_Hit debug}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {neigh_shared_icache_tb.dut.icache.UCACHE[0].micro_cache.f0_req_valid}]} {}
    {[format {neigh_shared_icache_tb.dut.icache.UCACHE[0].micro_cache.f0_req_pipe_valid}]} {}
