
#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

array unset createdGroup
array set createdGroup {}
#
# Groups
#
if {[catch {group get -using [list {Clock and reset}]}]} {
set createdGroup([list {Clock and reset}]) 1
catch {group new -name {Clock and reset} -overlay 0}
}
if {[catch {group get -using [list {Minion model}]}]} {
set createdGroup([list {Minion model}]) 1
catch {group new -name {Minion model} -overlay 0}
}
if {[catch {group get -using [list {Minion request port}]}]} {
set createdGroup([list {Minion request port}]) 1
catch {group new -name {Minion request port} -overlay 0}
}
if {[catch {group get -using [list {Shared icache arbiter (requestor 0)}]}]} {
set createdGroup([list {Shared icache arbiter (requestor 0)}]) 1
catch {group new -name {Shared icache arbiter (requestor 0)} -overlay 0}
}
if {[catch {group get -using [list {Response port}]}]} {
set createdGroup([list {Response port}]) 1
catch {group new -name {Response port} -overlay 0}
}
if {[catch {group get -using [list {Prefetch}]}]} {
set createdGroup([list {Prefetch}]) 1
catch {group new -name Prefetch -overlay 0}
}
if {[catch {group get -using [list {Prefetch Check_Hit debug}]}]} {
set createdGroup([list {Prefetch Check_Hit debug}]) 1
catch {group new -name {Prefetch Check_Hit debug} -overlay 0}
}
if {[catch {group get -using [list {L0 micro-cache (requestor 0)}]}]} {
set createdGroup([list {L0 micro-cache (requestor 0)}]) 1
catch {group new -name {L0 micro-cache (requestor 0)} -overlay 0}
}
if {[catch {group get -using [list {L1 icache_top}]}]} {
set createdGroup([list {L1 icache_top}]) 1
catch {group new -name {L1 icache_top} -overlay 0}
}
if {[catch {group get -using [list {L2 port}]}]} {
set createdGroup([list {L2 port}]) 1
catch {group new -name {L2 port} -overlay 0}
}
if {[catch {group get -using [list {L1 data SRAM model}]}]} {
set createdGroup([list {L1 data SRAM model}]) 1
catch {group new -name {L1 data SRAM model} -overlay 0}
}
if {[catch {group get -using [list {Testbench status}]}]} {
set createdGroup([list {Testbench status}]) 1
catch {group new -name {Testbench status} -overlay 0}
}
if {[info exists createdGroup([list {Clock and reset}])]} {
group using {Clock and reset}
group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {neigh_shared_icache_tb.clock}]} ] \
    [subst  {[format {neigh_shared_icache_tb.reset}]} ]
}

if {[info exists createdGroup([list {Minion model}])]} {
