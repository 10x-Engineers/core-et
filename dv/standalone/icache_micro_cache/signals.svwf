set groupId0 [waveform add -groups {{Clock and reset}}]


set groupId0 [waveform add -groups {{Minion model}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {neigh_shared_icache_tb.m_state[0]}]} {}
    {[format {neigh_shared_icache_tb.m_state[1]}]} {}
    {[format {neigh_shared_icache_tb.m_kick[0]}]} {}
    {[format {neigh_shared_icache_tb.m_kick[1]}]} {}
    {[format {neigh_shared_icache_tb.grant_count}]} {-radix %d}
    {[format {neigh_shared_icache_tb.retry_count}]} {-radix %d}
    {[format {neigh_shared_icache_tb.fill_done_count}]} {-radix %d}
}] childcmds {
    {}
    {}
    {}
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}


set groupId0 [waveform add -groups {{Minion request port}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {neigh_shared_icache_tb.f0_req_valid[7:0]}]} {-radix %b}
    {[format {neigh_shared_icache_tb.f0_req_ready[7:0]}]} {-radix %b}
    {[format {neigh_shared_icache_tb.f0_req[0].addr}]} {-radix %x}
    {[format {neigh_shared_icache_tb.f0_req[1].addr}]} {-radix %x}
}] childcmds {
    {}
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}


set groupId0 [waveform add -groups {{Shared icache arbiter (requestor 0)}}]
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {[format {neigh_shared_icache_tb.dut.f1_req_valid[1]}]} {-radix %b}
    {[format {neigh_shared_icache_tb.dut.f1_req_bid[0]}]} {-radix %b}
    {[format {neigh_shared_icache_tb.dut.f1_req_bid[1]}]} {-radix %b}
    {[format {neigh_shared_icache_tb.dut.f1_req_valid[0]}]} {-radix %b}
    {[format {neigh_shared_icache_tb.dut.f1_req_ready[7:0]}]} {}
    {[format {neigh_shared_icache_tb.dut.REQ_ARB[0].f1_grant[7:0]}]} {-radix %b}
    {[format {neigh_shared_icache_tb.dut.REQ_ARB[0].f4_grant[7:0]}]} {-radix %b}
    {[format {neigh_shared_icache_tb.dut.f1_req_arb_valid[1:0]}]} {-radix %b}
    {[format {neigh_shared_icache_tb.dut.f1_req_arb_ready[1:0]}]} {-radix %b}
}] childcmds {
    {}
    {}
    {}
    {}
    {
        set id $gpID0
        waveform hierarchy expand $id
    }
    {}
    {}
    {
        set id $gpID0
        waveform hierarchy collapse $id
    }
    {}
} {
    set expected [ join [waveform signals -format path $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}


