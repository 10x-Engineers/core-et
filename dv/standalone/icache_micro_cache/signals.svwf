group set -overlay 0
group set -comment {}
group clear 0 end
group insert \
    [subst  {[format {neigh_shared_icache_tb.m_state[0]}]} ] \
    [subst  {[format {neigh_shared_icache_tb.m_state[1]}]} ] \
    [subst  {[format {neigh_shared_icache_tb.m_kick[0]}]} ] \
    [subst  {[format {neigh_shared_icache_tb.m_kick[1]}]} ] \
