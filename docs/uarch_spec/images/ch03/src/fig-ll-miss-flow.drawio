<mxfile><diagram name="miss-flow"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Lookup reaches F2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="190" height="44" as="geometry"/></mxCell><mxCell id="n2" value="f2_hit ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="190" height="54" as="geometry"/></mxCell><mxCell id="n3" value="Respond with the block.&lt;br&gt;Priority updated.&lt;br&gt;Miss counter cleared." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="104" width="210" height="62" as="geometry"/></mxCell><mxCell id="n4" value="TLB miss ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="190" height="54" as="geometry"/></mxCell><mxCell id="n5" value="Translation requested from the PTW.&lt;br&gt;Miss response, thread sleeps." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="204" width="210" height="62" as="geometry"/></mxCell><mxCell id="n6" value="page or access fault ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="190" height="54" as="geometry"/></mxCell><mxCell id="n7" value="Fault reported with the response.&lt;br&gt;Priority updated, counters cleared.&lt;br&gt;Core takes the trap." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="304" width="210" height="62" as="geometry"/></mxCell><mxCell id="n8" value="f0_miss_state == R